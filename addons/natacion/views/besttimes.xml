<odoo>
    <record model="ir.ui.view" id="natacion.besttime_tree_view">
        <field name="name">natacion.besttime.tree</field>
        <field name="model">natacion.besttime</field>
        <field name="arch" type="xml">
            <list string="Mejores Tiempos">
                <field name="swimmer"/>
                <field name="style"/>
                <field name="category"/>
                <field name="time"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="natacion.besttime_form_view">
        <field name="name">natacion.besttime.form</field>
        <field name="model">natacion.besttime</field>
        <field name="arch" type="xml">
            <form string="Mejor Tiempo">
                <sheet>
                    <group>
                        <field name="swimmer"/>
                        <field name="style"/>
                        <field name="category"/>
                        <field name="time"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
