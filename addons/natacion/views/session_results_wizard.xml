<odoo>
    <record id="view_session_results_wizard_form" model="ir.ui.view">
        <field name="name">natacion.session.results.wizard.form</field>
        <field name="model">natacion.session.results.wizard</field>
        <field name="arch" type="xml">
            <form string="Introducir Tiempos de la Serie">
                <sheet>
                    <group>
                        <group>
                            <field name="session" options="{'no_create': True, 'no_open': True}"/>
                            <field name="test" 
                                   domain="[('session', '=', session)]" 
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="series" 
                                   domain="[('test', '=', test)]" 
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cronometraje" name="cronometraje">
                            <field name="result_line" nolabel="1">
                                <list editable="bottom" create="0" delete="0">
                                     <field name="swimmer" readonly="1"/> 
                                    <field name="time" string="Tiempo (Segundos)"/>
                                </list>
                            </field>
                        </page> 
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_save_results" string="Guardar Resultados" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo> 