<odoo>
    <record id="natacion.session_tree_view" model="ir.ui.view">
        <field name="name">natacion.session.tree</field>
        <field name="model">natacion.session</field>
        <field name="arch" type="xml">
            <list string="Sesiones">
                <field name="name"/>
                <field name="date"/>
                <field name="championship_id"/>
                <field name="duration"/>
                </list>
        </field>
    </record>

    <record model="ir.ui.view" id="natacion.session_form_view">
        <field name="name">natacion.session.form</field>
        <field name="model">natacion.session</field>
        <field name="arch" type="xml">
            <form string="Sesión">
                <header>
                    <button name="%(action_ticket_wizard_view)d" 
                    string="Generar Entradas" 
                    type="action" 
                    class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="championship_id"/>
                        <field name="duration" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Pruebas">
                            <field name="test_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="style"/>
                                    <field name="category"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
