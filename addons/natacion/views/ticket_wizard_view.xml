<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_natacion_session_ticket_wizard_form" model="ir.ui.view">
        <field name="name">natacion.session.ticket.wizard.form</field>
        <field name="model">natacion.session.ticket.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Entradas">
                <group>
                    <field name="session_id" readonly="1"/>
                    <field name="number_of_tickets"/>
                </group>
                <footer>
                    <button name="action_print_tickets" string="Imprimir PDF" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ticket_wizard_view" model="ir.actions.act_window">
        <field name="name">Generar Entradas</field>
        <field name="res_model">natacion.session.ticket.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_session_id': active_id}</field>
    </record>
</odoo>