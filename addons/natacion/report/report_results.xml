<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_natacion_results" model="ir.actions.report">
        <field name="name">Resultados del Campeonato</field>
        <field name="model">natacion.championship</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">natacion.report_results_template</field>
        <field name="report_file">natacion.report_results_template</field>
        <field name="print_report_name">'Resultados - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_natacion_championship"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_results_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        
                        <h2 class="text-center">Resultados: <span t-field="o.name"/></h2>
                        <p class="text-muted text-center">
                            Desde: <span t-field="o.date_start"/> Hasta: <span t-field="o.date_end"/>
                        </p>

                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Pos</th>
                                    <th>Nadador</th>
                                    <th>Club</th>
                                    <th>Prueba</th>
                                    <th class="text-right">Tiempo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="results" t-value="request.env['natacion.result'].search([('series.test.session.championship_id', '=', o.id)], order='time asc')"/>
                                
                                <t t-foreach="results" t-as="res">
                                    <tr>
                                        <td><span t-esc="res_index + 1"/>º</td>
                                        <td><span t-field="res.swimmer.name"/></td>
                                        <td><span t-field="res.swimmer.club.name"/></td>
                                        <td><span t-field="res.series.test.name"/></td>
                                        <td class="text-right">
                                            <span t-field="res.time"/> s
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>